{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": ".build",
    "rootDir": ".",
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "sdk/**/*.ts",
    "sdk/**/*.js"
  ]
}

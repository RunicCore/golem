{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}

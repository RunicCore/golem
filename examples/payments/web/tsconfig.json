{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "outDir": "../.build/web",
    "rootDir": ".",
    "plugins": [{ "transform": "@exprtlabs/golem/ttsc-plugin" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "sdk/**/*.ts"]
}

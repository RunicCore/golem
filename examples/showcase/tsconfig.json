{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": false,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": ".",
    "outDir": ".build",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "plugins": [
      { "transform": "@exprtlabs/codegen/ttsc-plugin" }
    ]
  },
  "include": [
    "backend/**/*.ts",
    "sdk/**/*.ts",
    "src/**/*.ts"
  ]
}

{
  "name": "nest-openapi-example",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "runic-codegen generate",
    "check": "runic-codegen check && ttsc --noEmit",
    "test": "runic-codegen check && ttsc && node --test .build/src/app.test.js",
    "start": "runic-codegen check && ttsc && node .build/src/main.js",
    "client": "ttsc && node .build/src/run-client.js"
  },
  "dependencies": {
    "@exprtlabs/golem": "1.0.0-rc",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@exprtlabs/golem-model": "1.0.0-rc",
    "@exprtlabs/golem-openapi": "1.0.0-rc",
    "@exprtlabs/golem-ts-openapi": "1.0.0-rc",
    "typescript": "7.x",
    "ttsc": "0.30.x",
    "@types/node": "22.20.1"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".build",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": false,
    "incremental": true,
    "tsBuildInfoFile": ".build/tests.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/fixtures/**"
  ]
}

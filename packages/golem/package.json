{
  "name": "@exprtlabs/golem",
  "version": "1.0.0",
  "description": "Shared model runtime and independently extensible TypeScript generation CLI",
  "keywords": [
    "typescript",
    "golem",
    "codegen",
    "validation",
    "serialization",
    "openapi",
    "nestjs",
    "models",
    "mobx"
  ],
  "author": "exprtlabs.ai",
  "license": "MIT",
  "homepage": "https://exprtlabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunicCore/golem.git",
    "directory": "packages/golem"
  },
  "bugs": {
    "url": "https://github.com/RunicCore/golem/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "golem": "./dist/bin/golem.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/bin/golem.js",
    "./dist/tooling/register.js"
  ],
  "exports": {
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./validation-runtime": {
      "types": "./dist/validation-runtime.d.ts",
      "import": "./dist/validation-runtime.js",
      "default": "./dist/validation-runtime.js"
    },
    "./mobx": {
      "types": "./dist/mobx.d.ts",
      "import": "./dist/mobx.js",
      "default": "./dist/mobx.js"
    },
    "./mobx-validation": {
      "types": "./dist/mobx-validation.d.ts",
      "import": "./dist/mobx-validation.js",
      "default": "./dist/mobx-validation.js"
    },
    "./manifest": {
      "types": "./dist/tooling/model-manifest.d.ts",
      "import": "./dist/tooling/model-manifest.js",
      "default": "./dist/tooling/model-manifest.js"
    },
    "./internal/emitter": {
      "types": "./dist/tooling/model-source-emitter.d.ts",
      "import": "./dist/tooling/model-source-emitter.js",
      "default": "./dist/tooling/model-source-emitter.js"
    },
    "./generator-api": {
      "types": "./dist/tooling/generator-api.d.ts",
      "import": "./dist/tooling/generator-api.js",
      "default": "./dist/tooling/generator-api.js"
    },
    "./internal/generated-paths": {
      "types": "./dist/tooling/generated-paths.d.ts",
      "import": "./dist/tooling/generated-paths.js",
      "default": "./dist/tooling/generated-paths.js"
    },
    "./rewrite": {
      "types": "./dist/tooling/rewrite.d.ts",
      "import": "./dist/tooling/rewrite.js",
      "default": "./dist/tooling/rewrite.js"
    },
    "./loader": {
      "types": "./dist/tooling/loader.d.ts",
      "import": "./dist/tooling/loader.js",
      "default": "./dist/tooling/loader.js"
    },
    "./vite": {
      "types": "./dist/tooling/vite.d.ts",
      "import": "./dist/tooling/vite.js",
      "default": "./dist/tooling/vite.js"
    },
    "./esbuild": {
      "types": "./dist/tooling/esbuild.d.ts",
      "import": "./dist/tooling/esbuild.js",
      "default": "./dist/tooling/esbuild.js"
    },
    "./register": {
      "types": "./dist/tooling/register.d.ts",
      "import": "./dist/tooling/register.js",
      "default": "./dist/tooling/register.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./conversion": {
      "types": "./dist/conversion.d.ts",
      "import": "./dist/conversion.js",
      "default": "./dist/conversion.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "import": "./dist/tags.js",
      "default": "./dist/tags.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js",
      "default": "./dist/temporal.js"
    },
    "./internal/schema": {
      "types": "./dist/tooling/schema.d.ts",
      "import": "./dist/tooling/schema.js",
      "default": "./dist/tooling/schema.js"
    },
    "./internal/schema-graph": {
      "types": "./dist/tooling/schema-graph.d.ts",
      "import": "./dist/tooling/schema-graph.js",
      "default": "./dist/tooling/schema-graph.js"
    },
    "./serde": {
      "types": "./dist/serde.d.ts",
      "import": "./dist/serde.js",
      "default": "./dist/serde.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "default": "./dist/nest.js"
    },
    "./internal/validation-plan": {
      "types": "./dist/tooling/validation-plan.d.ts",
      "import": "./dist/tooling/validation-plan.js",
      "default": "./dist/tooling/validation-plan.js"
    },
    "./internal/validator-compiler": {
      "types": "./dist/tooling/validator-compiler/index.d.ts",
      "import": "./dist/tooling/validator-compiler/index.js",
      "default": "./dist/tooling/validator-compiler/index.js"
    },
    "./internal/type-analysis": {
      "types": "./dist/tooling/type-analysis/index.d.ts",
      "import": "./dist/tooling/type-analysis/index.js",
      "default": "./dist/tooling/type-analysis/index.js"
    },
    "./internal/ts": {
      "types": "./dist/tooling/typescript-ns.d.ts",
      "import": "./dist/tooling/typescript-ns.js",
      "default": "./dist/tooling/typescript-ns.js"
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "esbuild": "^0.25.12",
    "mobx": "^6.13.0",
    "rxjs": "^7.8.0",
    "typescript": ">=6.0.0 <7 || >=7.1.0-0 <8",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "mobx": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.2.3",
    "esbuild": "0.25.12",
    "mobx": "^6.16.1",
    "rxjs": "7.8.2",
    "typescript": "7.1.0-beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.tooling.json && node -e \"require('node:fs').chmodSync('dist/bin/golem.js', 0o755)\"",
    "clean": "node -e \"for (const target of ['dist', '../../.build/golem-runtime.tsbuildinfo', '../../.build/golem-tooling.tsbuildinfo']) require('node:fs').rmSync(target, { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build && tsc -p ../../tsconfig.package-check.json && node ../../.build/scripts/verify-package.js ."
  }
}

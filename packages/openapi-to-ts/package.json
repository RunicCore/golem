{
  "name": "@exprtlabs/openapi-to-ts",
  "version": "1.0.0-rc",
  "description": "Generate TypeScript SDKs from OpenAPI documents",
  "keywords": [
    "openapi",
    "typescript",
    "sdk",
    "codegen",
    "client",
    "validation"
  ],
  "author": "exprtlabs.ai",
  "license": "MIT",
  "homepage": "https://exprtlabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exprtlabs/codegen.git",
    "directory": "packages/openapi-to-ts"
  },
  "bugs": {
    "url": "https://github.com/exprtlabs/codegen/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MATRIX.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "exports": {
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js",
      "default": "./dist/generator.js"
    }
  },
  "dependencies": {
    "@exprtlabs/codegen": "1.0.0-rc",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "build": "ttsc -p tsconfig.json",
    "clean": "node -e \"for (const target of ['dist', '../../.build/openapi-to-ts.tsbuildinfo']) require('node:fs').rmSync(target, { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build && ttsc -p ../../tsconfig.package-check.json && node ../../.build/scripts/verify-package.js ."
  }
}

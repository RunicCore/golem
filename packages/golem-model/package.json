{
  "name": "@exprtlabs/golem-model",
  "version": "1.1.0-rc.0",
  "description": "Generate TypeScript model bases from IModel definitions",
  "keywords": [
    "typescript",
    "golem",
    "codegen",
    "models",
    "imodel",
    "validation",
    "serialization"
  ],
  "author": "exprtlabs.ai",
  "license": "MIT",
  "homepage": "https://exprtlabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunicCore/golem.git",
    "directory": "packages/golem-model"
  },
  "bugs": {
    "url": "https://github.com/RunicCore/golem/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist",
    "golem-schema.json",
    "README.md",
    "LICENSE"
  ],
  "golem": {
    "apiVersion": 2,
    "block": "model",
    "plan": "./plan",
    "generator": "./generator",
    "schema": "./golem-schema.json"
  },
  "exports": {
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js",
      "default": "./dist/plan.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js",
      "default": "./dist/generator.js"
    }
  },
  "dependencies": {
    "@exprtlabs/golem": "1.1.0-rc.0"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0 <7 || >=7.1.0-0 <8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"for (const target of ['dist', '../../.build/golem-model.tsbuildinfo']) require('node:fs').rmSync(target, { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build && tsc -p ../../tsconfig.package-check.json && node ../../.build/scripts/verify-package.js ."
  }
}
